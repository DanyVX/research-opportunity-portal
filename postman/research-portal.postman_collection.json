      "key": "opportunity_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Create opportunity 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/opportunities",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Vision Research\",\n  \"description\": \"Assist with image recognition experiments.\",\n  \"research_area\": \"Vision\",\n  \"faculty_name\": \"Dr. Example\",\n  \"department\": \"CS\",\n  \"required_skills\": \"Python\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2027-01-31\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"opportunity_id\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
